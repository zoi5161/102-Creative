# 102 Creative — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
#
# Vite exposes only variables prefixed with VITE_ to the browser.

# ===== Contact form submission (chọn 1 trong các cách dưới) =====

# Cách 1: Google Sheets via Apps Script Web App
# VITE_CONTACT_ENDPOINT=https://script.google.com/macros/s/XXXX/exec

# Cách 2: EmailJS
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# Cách 3: Telegram Bot (notify sales ngay)
# VITE_TELEGRAM_BOT_TOKEN=
# VITE_TELEGRAM_CHAT_ID=

# ===== Analytics (optional) =====
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_FB_PIXEL_ID=

# ===== Social / Floating buttons =====
# VITE_ZALO_PHONE=0888403232
